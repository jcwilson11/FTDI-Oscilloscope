@startuml
title ioScope Runtime Component View

skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

actor "User" as user

package "Launchers" {
component "controller.py\n<<entry point>>" as bootstrap
component "run_scope_qt\n(io_scope_qt.py)" as qtLauncher
component "ioScopeShell\n(io_scope_shell.py)" as shell
}

package "Oscilloscope Application" {
component "ioScopeSettingsStore\n<<JSON persistence>>" as settings

component "ioQtScopeWindow\n<<Qt host>>" as qtWindow
component "ioOscilloscopeView\n<<view contract>>" as viewContract
component "ioCompactOscilloscopeView" as compactView
component "ioDetailedOscilloscopeView" as detailedView

component "ioOscilloscopeController\n<<application controller>>" as controller
component "ioOscilloscopeModel\n<<state + viewport>>" as model
component "ioFilterPipeline\n<<scale + offset>>" as filterPipeline
component "ioWaveformGenerator\n<<preview source selector>>" as generator
component "ioGeneratedWaveformSource" as generatedSource
component "ioFileWaveformSource" as fileSource
component "ioFtdiWaveformSource" as ftdiSource

component "ioLiveOscilloscopeSession\n<<live acquisition facade>>" as liveSession
component "ioLiveSampleHistory" as history
}

package "ioLibrary Live Transport" {
component "ioPipelineController" as pipeline
component "ioTappedReadableByteStream" as tappedStream
interface "ioReadableByteStream" as readStream
component "ioGeneratedWaveformByteStream" as generatedStream
component "ioLiveFileTailByteStream" as fileTailStream
component "ioFtdiByteStream" as ftdiInputStream

interface "ioWritableByteStream" as writeStream
component "ioNullWritableByteStream" as nullSink
component "ioFileByteStream" as fileSink
component "ioFtdiOutputByteStream" as ftdiSink

component "ioUsbReadController\n<<read worker>>" as readWorker
queue "ioDataBuffer\n<<bounded circular buffer>>" as buffer
component "ioUsbWriteController\n<<write worker>>" as writeWorker
}

user --> bootstrap : run scope command
bootstrap --> qtLauncher : scope-qt
bootstrap --> shell : scope-shell

qtLauncher --> settings : load() / save()
qtLauncher --> controller : construct + restore state
qtLauncher --> qtWindow : construct + connectController()
shell --> settings : load() / save()
shell --> controller : construct + execute commands

qtWindow --> controller : UI events + timer refresh
qtWindow --> compactView : host in stacked window
qtWindow --> detailedView : host in stacked window

compactView ..> viewContract : implements
detailedView ..> viewContract : implements
controller --> compactView : connectController() + render()
controller --> detailedView : connectController() + render()
controller --> model : update/query state
controller --> liveSession : start() / stop() / latest_samples()

model --> filterPipeline : process(rawSignal)
model --> generator : refreshSamples()
generator --> generatedSource : generated preview mode
generator --> fileSource : file:path preview mode
generator --> ftdiSource : ftdi:index preview mode
ftdiSource --> ftdiInputStream : one-shot read_bytes()

controller --> settings : state-change listener callback

liveSession --> history : own rolling samples
liveSession --> readStream : choose live source
liveSession --> tappedStream : wrap selected input stream
liveSession --> pipeline : build + start + stop
liveSession --> writeStream : choose tee sink

tappedStream --> history : mirror payload to samples
tappedStream --> readStream : delegate stream calls
readStream --> generatedStream : generated live mode
readStream --> fileTailStream : live file mode
readStream --> ftdiInputStream : live FTDI mode

pipeline --> readWorker : manage lifecycle
pipeline --> writeWorker : manage lifecycle
pipeline --> buffer : create + close
pipeline --> tappedStream : inject as input_stream
pipeline --> writeStream : inject as output_stream

readWorker --> tappedStream : read_bytes()
readWorker --> buffer : push byte chunks
writeWorker --> buffer : pop byte chunks
writeWorker --> writeStream : write bytes

writeStream --> nullSink : tee disabled
writeStream --> fileSink : file tee mode
writeStream --> ftdiSink : FTDI tee mode

note bottom of qtWindow
run_scope_qt creates one shared list of the
compact and detailed view objects, then passes
those same instances into both the Qt window
and the oscilloscope controller.
end note

note bottom of controller
The controller has two acquisition paths.
Preview refresh uses ioOscilloscopeModel ->
ioWaveformGenerator. Live running mode also
starts ioLiveOscilloscopeSession beneath it.
end note

note bottom of buffer
ioDataBuffer is only the worker handoff inside
ioPipelineController. Rendered live samples are
read back from ioLiveSampleHistory, not from
the buffer directly.
end note
@enduml
