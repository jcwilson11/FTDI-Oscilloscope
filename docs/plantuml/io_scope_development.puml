@startuml
title ioScope Development View Overview
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

package "Bootstrap / CLI" as bootstrap {
  [controller.py]
  [io_scope_qt.py]
  [io_scope_shell.py]
  [io_pipeline_cli.py]
  [io_legacy_ftdi_cli.py]
  [io_file_comparator.py]
  [ftd2xx_wrapper.py]
}

package "oscilloscope/ MVC and State" as mvc {
  [MVC files]
  [state files]
  [compatibility files]
}

package "oscilloscope/ Signal and Live Session" as signal {
  [filter files]
  [source files]
  [theme files]
  [live-session files]
}

package "ioLibrary/ Streams" as streams {
  [stream files]
}

package "ioLibrary/ Pipeline and Legacy" as pipeline {
  [pipeline files]
  [legacy compatibility files]
}

package "tests/" as tests {
  [Qt and oscilloscope tests]
  [pipeline tests]
}

bootstrap --> mvc
bootstrap --> pipeline
bootstrap --> streams
mvc --> signal
signal --> streams
signal --> pipeline
pipeline --> streams
tests --> mvc
tests --> pipeline

note right of mvc
This overview is intentionally compact so it fits
in slides and Overleaf.
Use the split development slices for file-level traceability:
- io_scope_development_bootstrap_mvc.puml
- io_scope_development_signal_live.puml
- io_scope_development_iolibrary_streams.puml
- io_scope_development_iolibrary_pipeline.puml
end note
@enduml
